{
  "name": "ohmlet-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-sitemap.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "lint:lessons": "node scripts/lint-lessons.mjs && node scripts/check-lesson-solvability.mjs --self-test && node scripts/check-lesson-solvability.mjs",
    "check:solvability": "node scripts/check-lesson-solvability.mjs --self-test && node scripts/check-lesson-solvability.mjs",
    "check:api-coverage": "node scripts/check-api-coverage.mjs",
    "check:achievements": "node scripts/check-achievement-durability.mjs",
    "check:curriculum": "node scripts/check-curriculum-parity.mjs && node scripts/check-curriculum-fallback.mjs",
    "check:curriculum-parity": "node scripts/check-curriculum-parity.mjs",
    "check:curriculum-fallback": "node scripts/check-curriculum-fallback.mjs",
    "export:curriculum": "node scripts/export-curriculum.mjs",
    "check:prices": "node scripts/check-prices.mjs",
    "check": "npm run check:prices && npm run check:interview-contract && npm run check:films && npm run check:api-coverage && npm run check:achievements && npm run check:curriculum && npm run check:solvability && node scripts/check-theme.mjs",
    "check:interview-contract": "node scripts/check-interview-contract.mjs",
    "check:films": "node scripts/check-films.mjs",
    "sync:films": "node scripts/sync-films.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^9.117.0",
    "@react-three/fiber": "^8.17.10",
    "@types/three": "^0.183.1",
    "avr8js": "^0.21.0",
    "firebase": "^12.15.0",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-nice-avatar": "^1.5.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.10"
  },
  "license": "UNLICENSED"
}
