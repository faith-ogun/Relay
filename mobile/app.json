{
  "expo": {
    "name": "Ohmlet",
    "slug": "ohmlet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": [
      "ohmlet",
      "com.googleusercontent.apps.182102811288-7s9pk39kbo8tjt1sf4flou49jim43o4b"
    ],
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "org.ohmlet.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Ohmlet uses your camera so the tutor can see your breadboard and check your wiring as you build.",
        "NSMicrophoneUsageDescription": "Ohmlet uses your microphone so you can talk to the tutor while you build."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "org.ohmlet.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/android-foreground.png",
        "backgroundColor": "#fdc90b"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#facc2e",
          "image": "./assets/brand/mascot-wave.png",
          "imageWidth": 132,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      "expo-asset",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}